# === 資料來源 ===
CWA_API_KEY=                     # 中央氣象署開放資料 API 金鑰（https://opendata.cwa.gov.tw/ 免費註冊）
OPEN_METEO_API_KEY=              # Open-Meteo 付費版 API key（免費版可不填，留空即用免費 endpoint）
CDS_API_URL=https://cds.climate.copernicus.eu/api  # ERA5 CDS API
CDS_API_KEY=                     # CDS Personal Access Token

# === 資料庫（Supabase PostGIS）===
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<your-supabase-db-password>
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:6543/postgres

# 本機開發（選用，使用 Docker PostgreSQL）
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=utc_db
# DB_USER=utc
# DB_PASSWORD=utc_dev_password

# Supabase 專案 URL 與 anon key
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# === Redis（選用）===
REDIS_URL=redis://localhost:6379/0

# === 應用程式 ===
APP_ENV=development              # development | staging | production
LOG_LEVEL=INFO
DEFAULT_CITY=taipei
DEFAULT_GRID_SIZE=100            # 公尺

# === API 管理 ===
API_KEY_REQUIRED=false           # true: 需要 API Key 才能存取 API
DEFAULT_RATE_LIMIT_PER_MIN=60
ADMIN_API_KEY=

# === Martin Tile Server ===
MARTIN_URL=http://localhost:3000

# === 前端（Vite）===
VITE_API_URL=http://localhost:8000
VITE_TILES_URL=http://localhost:3000

# === Docker（本機開發）===
POSTGRES_PASSWORD=utc_dev_password
