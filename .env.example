# === 資料來源 ===
CWA_API_KEY=                     # 中央氣象署開放資料 API 金鑰（https://opendata.cwa.gov.tw/ 免費註冊）
OPEN_METEO_API_KEY=              # Open-Meteo 付費版 API key（免費版可不填，留空即用免費 endpoint）
CDS_API_URL=https://cds.climate.copernicus.eu/api  # ERA5 CDS API（也可透過 ~/.cdsapirc 設定）
CDS_API_KEY=                     # CDS Personal Access Token（https://cds.climate.copernicus.eu/）
NLSC_ACCOUNT=                    # 國土測繪中心圖資商店帳號（選用）
NLSC_PASSWORD=                   # 國土測繪中心圖資商店密碼（選用）

# === 資料庫（Supabase PostGIS）===
# 從 Supabase Dashboard → Settings → Database 取得
# 連線模式：Transaction mode (port 6543) 或 Session mode (port 5432)
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<your-supabase-db-password>

# 本機開發（選用，使用本機 PostgreSQL）
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=utc
# DB_USER=utc
# DB_PASSWORD=utc

# Supabase 專案 URL 與 anon key（前端 / Storage 用）
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# === Redis（選用，本機快取）===
REDIS_URL=redis://localhost:6379/0

# === 應用程式 ===
APP_ENV=development              # development | staging | production
LOG_LEVEL=INFO
DEFAULT_CITY=taipei
DEFAULT_GRID_SIZE=100            # 公尺

# === API 管理 ===
API_KEY_REQUIRED=false           # true: 需要 API Key 才能存取 API（生產環境建議開啟）
DEFAULT_RATE_LIMIT_PER_MIN=60    # 預設每分鐘請求限制
ADMIN_API_KEY=                   # 管理用 master key（不限流、可查看使用量）
