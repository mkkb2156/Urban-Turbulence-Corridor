# === 資料來源 ===
CWA_API_KEY=                     # 中央氣象署開放資料 API 金鑰
NLSC_ACCOUNT=                    # 國土測繪中心圖資商店帳號（選用）
NLSC_PASSWORD=                   # 國土測繪中心圖資商店密碼（選用）

# === 資料庫 ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=utc
DB_USER=utc
DB_PASSWORD=utc

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === 應用程式 ===
APP_ENV=development              # development | staging | production
LOG_LEVEL=INFO
DEFAULT_CITY=taipei
DEFAULT_GRID_SIZE=100            # 公尺
