    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@sakitam-gis/maplibre-wind": "^2.0.3",
    "@tanstack/react-query": "^5.20.0",
    "@tremor/react": "^3.18.7",
    "@turf/helpers": "^7.3.4",
    "@turf/interpolate": "^7.3.4",
    "@turf/isobands": "^7.3.4",
    "@turf/isolines": "^7.3.4",
    "chroma-js": "^3.2.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.344.0",
    "maplibre-gl": "^4.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.0",
