{
  "name": "utc-web",
  "private": true,
  "version": "1.0.0",
  "description": "Urban Turbulence Corridor — Taiwan urban wind corridor mapping dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
